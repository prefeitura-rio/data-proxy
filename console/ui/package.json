{
	"name": "console",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"test": "vitest run",
		"coverage": "vitest run --coverage",
		"test:browser": "bddgen && playwright test",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint . && prettier --ignore-path ../../.prettierignore --check .",
		"format": "prettier --ignore-path ../../.prettierignore --write ."
	},
	"dependencies": {
		"@aws-sdk/client-iam": "^3.1152.0",
		"@aws-sdk/client-s3": "^3.1152.0",
		"@aws-sdk/s3-request-presigner": "^3.1152.0",
		"pg": "^8.23.1",
		"valibot": "^1.5.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@lucide/svelte": "^1.58.0",
		"@playwright/test": "1.61.1",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24",
		"@types/pg": "^8.23.1",
		"@vitest/coverage-v8": "5.0.5",
		"daisyui": "^5.7.50",
		"eslint": "^10.13.0",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"playwright-bdd": "^9.2.1",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.2",
		"vite": "^8.3.0",
		"vitest": "^5.0.5"
	}
}
