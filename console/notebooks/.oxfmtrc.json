{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"singleQuote": true,
	"printWidth": 120,
	"trailingComma": "none",
	"sortPackageJson": false,
	"ignorePatterns": [
		"**/*.toml",
		"**/.venv",
		"**/build",
		"**/dist",
		"**/node_modules",
		"**/pnpm-lock.yaml",
		"**/site",
		"**/uv.lock"
	]
}
