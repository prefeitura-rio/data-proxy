FROM mcr.microsoft.com/playwright/python:v1.65.2-noble@sha256:38dd67fc654b56b3cba611e4c8eb71cd33750e1cd29eea2a5dc00b484817a75f AS notebooks

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

COPY --from=docker.io/node:24.22.3-bookworm-slim@sha256:dc26ae92c9fb15cf6b1d63e20f0944b2efe0f115b20e00be48fb23fceb061c54 /usr/local /usr/local
COPY --from=ghcr.io/astral-sh/uv:0.13.9@sha256:d3b601f0c7b118bc1753febf7c41cc80981df678445e0254284eecf84db79a7d /uv /usr/local/bin/uv

RUN curl -fsSL -o /tmp/nu.tar.gz https://github.com/nushell/nushell/releases/download/0.116.0/nu-0.116.0-x86_64-unknown-linux-gnu.tar.gz \
    && echo "9f73a6913f9515a621bd916dc91d7f3e0494e488161c2d686f6b98ffa0555945  /tmp/nu.tar.gz" | sha256sum --check - \
    && tar xzf /tmp/nu.tar.gz -C /usr/local/bin --strip-components=1 \
    && rm /tmp/nu.tar.gz \
    && npm install --global pnpm@11.25.0

WORKDIR /app

COPY console/notebooks/package.json console/notebooks/pnpm-lock.yaml console/notebooks/pnpm-workspace.yaml console/notebooks/pyproject.toml console/notebooks/uv.lock ./
RUN pnpm install --frozen-lockfile && uv sync --frozen

COPY console/notebooks/ ./

RUN nu build.nu notebooks/query.py site

FROM docker.io/node:24.22.3-alpine3.23@sha256:3946fb783fdce8a2812136ea694bc95c698c4f4096f3fd18568dc27a8ac389dc AS build

RUN npm install --global pnpm@11.25.0

WORKDIR /app

COPY console/ui/package.json console/ui/pnpm-lock.yaml console/ui/.npmrc ./
RUN pnpm install --frozen-lockfile

COPY console/ui/ ./

RUN OIDC_ISSUER=build OIDC_CLIENT_ID=build OIDC_CLIENT_SECRET=build COOKIE_SECRET=build \
    POSTGREST_URL=http://build ORIGIN=http://build pnpm build

FROM docker.io/node:24.22.3-alpine3.23@sha256:3946fb783fdce8a2812136ea694bc95c698c4f4096f3fd18568dc27a8ac389dc

RUN npm install --global pnpm@11.25.0

WORKDIR /app

COPY console/ui/package.json console/ui/pnpm-lock.yaml console/ui/.npmrc ./
RUN pnpm install --frozen-lockfile --prod

COPY --from=build /app/build ./build
COPY --from=notebooks /app/site ./notebooks/site
COPY console/notebooks/server.ts console/notebooks/serve.ts console/notebooks/csp.ts ./notebooks/
COPY console/notebooks/src/page.ts ./notebooks/src/

USER node

EXPOSE 3000 8080

CMD ["node", "build"]
