FROM docker.io/library/nginx:stable

RUN apt-get update \
 && apt-get install -y nginx-module-njs nodejs npm \
 && apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY nginx/tsconfig.json nginx/tsconfig.build.json nginx/fallback.ts nginx/
RUN npm install --no-save njs-types@1.0.0 typescript@7.0.2 \
 && ./node_modules/.bin/tsc -p nginx/tsconfig.build.json \
 && rm -rf /build

COPY nginx/nginx.conf /etc/nginx/nginx.conf

EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
