FROM docker.io/library/nginx:stable

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
    nginx-module-njs=1.30.5+1.0.1-1~trixie \
 && apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /build

COPY --from=docker.io/library/node:24-slim /usr/local/bin/node /usr/local/bin/node

COPY --from=docker.io/library/node:24-slim /usr/local/bin/npx /usr/local/bin/npx

COPY --from=docker.io/library/node:24-slim /usr/local/lib/node_modules /usr/local/lib/node_modules

RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm

COPY proxy/tsconfig.json proxy/tsconfig.build.json proxy/proxy.ts proxy/

RUN npm install --no-save njs-types@1.0.0 typescript@7.0.2 \
 && ./node_modules/.bin/tsc -p proxy/tsconfig.build.json \
 && rm -rf /build

COPY helm/files/nginx.conf /etc/nginx/templates/nginx.conf.template

ENV NGINX_ENVSUBST_TEMPLATE_DIR=/etc/nginx/templates \
    NGINX_ENVSUBST_TEMPLATE_SUFFIX=.template \
    NGINX_ENVSUBST_OUTPUT_DIR=/etc/nginx \
    NGINX_ENVSUBST_FILTER=^(CACHE_TTL|MAX_BODY|HA_MODE|FETCH_BUFFER_SIZE|FETCH_TIMEOUT|FETCH_KEEPALIVE|FETCH_KEEPALIVE_TIMEOUT|LARGE_CLIENT_HEADER_BUFFERS)$

EXPOSE 8080
