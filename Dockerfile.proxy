FROM docker.io/library/nginx:stable

RUN apt-get update \
 && apt-get install -y nginx-module-njs nodejs npm \
 && apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY nginx/tsconfig.json nginx/tsconfig.build.json nginx/fallback.ts nginx/
RUN npm install --no-save njs-types@1.0.0 typescript@7.0.2 \
 && ./node_modules/.bin/tsc -p nginx/tsconfig.build.json \
 && rm -rf /build

COPY helm/files/nginx.conf /etc/nginx/templates/nginx.conf.template

ENV NGINX_ENVSUBST_TEMPLATE_DIR=/etc/nginx/templates \
    NGINX_ENVSUBST_TEMPLATE_SUFFIX=.template \
    NGINX_ENVSUBST_OUTPUT_DIR=/etc/nginx \
    NGINX_ENVSUBST_FILTER=^(CACHE_TTL|MAX_BODY|FETCH_BUFFER_SIZE|FETCH_TIMEOUT|FETCH_KEEPALIVE|FETCH_KEEPALIVE_TIMEOUT|LARGE_CLIENT_HEADER_BUFFERS)$

EXPOSE 8080
