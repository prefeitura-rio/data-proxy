{
  "schemas": {
    "test": {
      "claim": "preferred_username",
      "tables": [
        {
          "name": "rj-ia-desenvolvimento.dev.full_table",
          "strategy": "full",
          "rls": [
            {
              "column": "unit_id",
              "unit_type": "unit"
            }
          ]
        },
        {
          "name": "rj-ia-desenvolvimento.dev.partitioned_table",
          "strategy": "partitioned",
          "fallbacks": ["bigquery"],
          "n": 4,
          "partitioning": {
            "column": "date",
            "interval": "daily",
            "retention": "365 days"
          },
          "rls": [
            {
              "column": "unit_id",
              "unit_type": "unit"
            }
          ]
        },
        {
          "name": "rj-ia-desenvolvimento.dev.multi_rls_table",
          "strategy": "full",
          "rls": [
            {
              "column": "region_id",
              "unit_type": "region"
            },
            {
              "column": "group_id",
              "unit_type": "group"
            }
          ]
        }
      ]
    }
  }
}
