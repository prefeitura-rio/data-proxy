# Postgres / pg_duckdb (docker-compose defaults, override if needed)
DB_USER=poc
DB_PASSWORD=poc
DB_NAME=poc

# GCP — sandbox project, already used for dbt dev/PR testing
GCP_PROJECT_ID=rj-iplanrio-dev
BQ_DATASET=poc_pg_duckdb_postgrest
GCS_BUCKET=rj-iplanrio-dev-poc-pg-duckdb-postgrest
GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json

# GCS HMAC key for pg_duckdb's duckdb.create_simple_secret() (S3-interop API)
# Generate via: gcloud storage hmac create <service-account-email> --project=$GCP_PROJECT_ID
GCS_HMAC_KEY_ID=
GCS_HMAC_SECRET=
