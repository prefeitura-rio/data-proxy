FROM ghcr.io/astral-sh/uv:python3.14-trixie-slim

WORKDIR /app

RUN useradd --create-home --uid 10001 appuser

COPY pyproject.toml uv.lock ./

RUN uv sync --frozen --no-dev

RUN chown -R appuser:appuser /app

USER appuser

RUN .venv/bin/python -c "from duckdb import connect; c = connect(); c.execute('INSTALL httpfs'); c.execute('LOAD httpfs'); c.execute('INSTALL ducklake'); c.execute('LOAD ducklake'); c.execute('INSTALL sqlite'); c.execute('LOAD sqlite'); c.execute('INSTALL postgres_scanner'); c.execute('LOAD postgres_scanner'); c.execute('INSTALL bigquery FROM community'); c.execute('LOAD bigquery')"

COPY --chown=appuser:appuser src/ src/

ENV PATH=/app/.venv/bin:$PATH
ENV PYTHONPATH=/app/src
