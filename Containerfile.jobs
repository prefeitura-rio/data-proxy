FROM docker.io/debian:trixie-slim@sha256:62bd423aeee912639ca8ee681c2b762cb3e25137e0a92b20be455898a9f034ad

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl=8.14.1-2+deb13u7 \
    ca-certificates=20250419+deb13u1 \
    xz-utils=5.8.1-1+deb13u2 \
    && curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc -o /usr/share/keyrings/pgdg.asc \
    && echo "0144068502a1eddd2a0280ede10ef607d1ec592ce819940991203941564e8e76  /usr/share/keyrings/pgdg.asc" | sha256sum --check \
    && echo "deb [signed-by=/usr/share/keyrings/pgdg.asc] https://apt.postgresql.org/pub/repos/apt trixie-pgdg main" > /etc/apt/sources.list.d/pgdg.list \
    && apt-get update && apt-get install -y --no-install-recommends \
    postgresql-client-18=18.6-1.pgdg13+2 \
    rclone=1.60.1+dfsg-4 \
    && curl -fsSL https://github.com/mitsuhiko/minijinja/releases/download/2.24.0/minijinja-cli-x86_64-unknown-linux-gnu.tar.xz | tar xJ -C /usr/local/bin --strip-components=1 \
    && curl -fsSL https://github.com/nushell/nushell/releases/download/0.116.0/nu-0.116.0-x86_64-unknown-linux-gnu.tar.gz | tar xz -C /usr/local/bin --strip-components=1 \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

COPY --from=registry.k8s.io/kubectl:v1.34.7@sha256:e77b87f5471e9f2c3f0c4a55bb9279e9ccd1734f7814b766b7ac099fd3ae9bfa /bin/kubectl /usr/local/bin/kubectl

RUN useradd --create-home --uid 1000 nushell
USER nushell
