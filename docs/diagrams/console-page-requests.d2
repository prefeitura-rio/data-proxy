shape: sequence_diagram

u: Browser
app: "Console server"
api: PostgREST
db: PostgreSQL
w: "Sync worker"

page: "Load a page" {
  u -> app: "GET /sync"
  app -> api: "views, with the user token"
  api -> db: "switch role, check rights"
  db -> api: "rows" {style.stroke-dash: 3}
  api -> app: "rows" {style.stroke-dash: 3}
  app -> u: "page" {style.stroke-dash: 3}
}
run: "Start a run" {
  u -> app: "press Start run"
  app -> api: "POST /rpc/start_sync"
  api -> db: "enqueue run_sync"
  w -> db: "take the run"
}
edit: "Edit the configuration" {
  u -> app: "save a change"
  app -> api: "write a row"
  api -> db: "check schemas, run triggers"
  w -> db: "take queued workflows"
}
