shape: sequence_diagram

c: "API client"
idp: "Identity provider"
gw: "Istio gateway"
pgrst: PostgREST
db: PostgreSQL

c -> idp: "ask for a token"
idp -> c: "JWT with role, schemas\nand preferred_username" {style.stroke-dash: 3}
c -> gw: "request with Authorization: Bearer"
gw -> idp: "signing keys (JWKS), cached"
gw -> gw: "check signature, issuer,\naudience and expiry"
gw -> pgrst: "request"
pgrst -> db: "switch to the role claim"
db -> pgrst: "rows allowed by the policy" {style.stroke-dash: 3}
pgrst -> c: "answer" {style.stroke-dash: 3}
