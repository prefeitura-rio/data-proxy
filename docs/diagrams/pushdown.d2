direction: down

request: "GET request"
read: "Does the proxy read\nevery parameter?" {shape: diamond}
agg: "Does the select have\naggregates?" {shape: diamond}
supported: "Group, functions and order\nare supported?" {shape: diamond}
call: "Call table_aggregate\nDuckDB groups the rows"
null: "Answer null, error\nor a fallback source?" {shape: diamond}
table: "Read the table view" {
  where: "where: filter the rows"
  columns: "columns: read fewer columns"
  limit: "limit and order: stop early\nonly for a plain read and\nsimple order columns"
}
postgrest: "PostgREST answers\nthe original request"
answer: "Send the answer\nand cache it"

request -> read
read -> postgrest: "no"
read -> agg: "yes"
agg -> table: "no"
agg -> supported: "yes"
supported -> postgrest: "no"
supported -> call: "yes"
call -> null
null -> postgrest: "yes"
null -> answer: "no"
table -> answer
postgrest -> answer
