direction: right

keda: "KEDA" {
  sync_trigger: "Count of active DBOS workflows\nevery 30 seconds"
  cpu: "CPU 70% and memory 90%"
  cpu_proxy: "CPU 70%"
  sessions: "Active PostgREST sessions\nfor each instance"
}

targets: "Scaled workloads" {
  sync: "Sync workers\n3 to 15 pods"
  postgrest: "PostgREST\n1 to 6 pods"
  proxy: "Proxy\n1 to 6 pods"
  cnpg: "CNPG instances\n2 to 6"
}

pgdog: "PgDog\nfixed: pgdog.replicas" {style.stroke-dash: 3}

keda.sync_trigger -> targets.sync
keda.cpu -> targets.postgrest
keda.cpu_proxy -> targets.proxy
keda.sessions -> targets.cnpg
