direction: right

client: "Client"
gateway: "Istio gateway" {
  vs: "VirtualService"
}
jwt: "JWT check\ningress.auth.enabled"

api: "API host\ndata-proxy.dados.rio" {
  proxy: "Proxy to PostgREST\n/ and the tables"
  docs: "Swagger UI\n/docs"
  console: "Console\n/console"
}
nb: "Notebook host\nnotebooks.data-proxy.dados.rio" {
  site: "Notebook site"
}

client -> gateway.vs
gateway.vs -> jwt: "/ and /docs"
jwt -> api.proxy
jwt -> api.docs
gateway.vs -> api.console: "/console\nsigns in with OIDC"
gateway.vs -> nb.site: "other host,\nother origin"
