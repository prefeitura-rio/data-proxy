FROM docker.io/pgduckdb/pgduckdb:18-main@sha256:d81c6250eca8fe8d0495d0e7886cbd72741425097a9aa01e3e8fa3de4cb7ec6c

USER root

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl=7.88.1-10+deb12u15 \
    postgresql-18-postgis-3=3.7.0+dfsg-1.pgdg12+1 \
    postgresql-18-postgis-3-scripts=3.7.0+dfsg-1.pgdg12+1 && \
  apt-get clean && rm -rf /var/lib/apt/lists/*

RUN groupmod --gid 998 tape && \
  groupmod --gid 26 postgres && \
  usermod --uid 26 --gid 26 postgres && \
  mkdir -p /usr/local/lib/pg_duckdb/extensions && \
  chown -R postgres:postgres /var/lib/postgresql /usr/local/lib/pg_duckdb

USER postgres

RUN initdb -D /tmp/pgdata --auth=trust && \
  pg_ctl -D /tmp/pgdata -o "-c shared_preload_libraries=pg_duckdb -c duckdb.allow_unsigned_extensions=on -c duckdb.allow_community_extensions=on -c duckdb.extension_directory=/usr/local/lib/pg_duckdb/extensions -c unix_socket_directories=/tmp" start && \
  psql -h /tmp -d postgres -c "CREATE EXTENSION IF NOT EXISTS pg_duckdb; SELECT duckdb.install_extension('postgres'); SELECT duckdb.install_extension('ducklake'); SELECT duckdb.install_extension('bigquery', 'community');" && \
  pg_ctl -D /tmp/pgdata stop -m immediate && \
  rm -rf /tmp/pgdata
