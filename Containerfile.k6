FROM docker.io/golang:1.27.4-alpine@sha256:70bd7ddea8b6cbe5d6943cde279d6b67feb10cc924fb9100d1d8757c1575b280 AS builder

RUN apk add --no-cache git=2.54.1-r0 && go install go.k6.io/xk6/cmd/xk6@v1.4.14 \
    && go install github.com/pelletier/go-toml/v2/cmd/tomljson@v2.2.4

WORKDIR /build

RUN xk6 build --with github.com/grafana/xk6-kubernetes@v0.12.0 -o /build/k6

COPY helm/files/config/rbac.toml /build/rbac.toml

RUN tomljson rbac.toml > rbac.json

FROM docker.io/alpine:3.24.4@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf

RUN adduser -D -u 10001 k6

COPY --from=builder /build/k6 /usr/local/bin/k6
COPY --from=builder /build/rbac.json /scripts/rbac.json
COPY k6/ /scripts/

WORKDIR /scripts

USER k6

ENTRYPOINT ["k6", "run"]
