FROM quay.io/keycloak/keycloak:26.4@sha256:9409c59bdfb65dbffa20b11e6f18b8abb9281d480c7ca402f51ed3d5977e6007 AS builder

ENV KC_DB=dev-file KC_HEALTH_ENABLED=false KC_METRICS_ENABLED=false

# Build the server once in the image, so that a start doesn't build it again. Keycloak then starts in 20 seconds
# and not in 33 on a runner with two cores. The test realm uses the file database.
RUN /opt/keycloak/bin/kc.sh build

FROM quay.io/keycloak/keycloak:26.4@sha256:9409c59bdfb65dbffa20b11e6f18b8abb9281d480c7ca402f51ed3d5977e6007

COPY --from=builder /opt/keycloak/ /opt/keycloak/
