  {
    "name": "pushes the selected columns",
    "query": "select=id,name",
    "expected": {
      "columns": [
        "id",
        "name"
      ]
    }
  },
  {
    "name": "pushes no columns for select star",
    "query": "select=*",
    "expected": null
  },
  {
    "name": "pushes no columns when select has a star among names",
    "query": "select=id,*",
    "expected": null
  },
  {
    "name": "adds the filter columns to the selected columns",
    "query": "select=name&id=eq.1",
    "expected": {
      "where": {
        "kind": "comparison",
        "column": "id",
        "operator": "eq",
        "negated": false,
        "value": "1"
      },
      "columns": [
        "name",
        "id"
      ]
    }
  },
  {
    "name": "adds the filter columns of a group",
    "query": "select=name&or=(id.eq.1,code.eq.2)",
    "expected": {
      "where": {
        "kind": "group",
        "operator": "or",
        "items": [
          {
            "kind": "comparison",
            "column": "id",
            "operator": "eq",
            "negated": false,
            "value": "1"
          },
          {
            "kind": "comparison",
            "column": "code",
            "operator": "eq",
            "negated": false,
            "value": "2"
          }
        ]
      },
      "columns": [
        "name",
        "id",
        "code"
      ]
    }
  },
  {
    "name": "pushes no columns when select has a cast",
