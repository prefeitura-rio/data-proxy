[
  {
    "name": "parses comparison filters",
    "query": "id=eq.42",
    "expected": {
      "where": {
        "kind": "comparison",
        "column": "id",
        "operator": "eq",
        "negated": false,
        "value": "42"
      }
    }
  },
  {
    "name": "parses nested logical filters",
    "query": "or=(and(id.gte.10,id.lt.20),name.ilike.*rio*)",
    "expected": {
      "where": {
        "kind": "group",
        "operator": "or",
        "items": [
          {
            "kind": "group",
            "operator": "and",
            "items": [
              {
                "kind": "comparison",
                "column": "id",
                "operator": "gte",
                "negated": false,
                "value": "10"
              },
              {
                "kind": "comparison",
                "column": "id",
                "operator": "lt",
                "negated": false,
                "value": "20"
              }
            ]
          },
          {
            "kind": "comparison",
            "column": "name",
            "operator": "ilike",
            "negated": false,
            "value": "*rio*"
          }
        ]
      }
    }
  },
  {
    "name": "parses quoted in-list values",
    "query": "name=in.(\"Rio, RJ\",\"O\\\"Connor\",plain)",
    "expected": {
      "where": {
        "kind": "comparison",
        "column": "name",
        "operator": "in",
        "negated": false,
        "value": [
          "Rio, RJ",
          "O\"Connor",
          "plain"
        ]
      }
    }
  },
  {
    "name": "parses is values and negated operators",
    "query": "deleted=is.not_null&name=not.ilike.*test*",
    "expected": {
      "where": {
        "kind": "group",
        "operator": "and",
        "items": [
          {
            "kind": "comparison",
            "column": "deleted",
            "operator": "is",
            "negated": false,
            "value": "not_null"
          },
          {
            "kind": "comparison",
            "column": "name",
            "operator": "ilike",
            "negated": true,
            "value": "*test*"
          }
        ]
      }
    }
  },
  {
    "name": "parses negated logical groups",
    "query": "not.and=(id.gte.1,id.lte.4)",
    "expected": {
      "where": {
        "kind": "group",
        "operator": "and",
        "negated": true,
        "items": [
          {
            "kind": "comparison",
            "column": "id",
            "operator": "gte",
            "negated": false,
            "value": "1"
          },
          {
            "kind": "comparison",
            "column": "id",
            "operator": "lte",
            "negated": false,
            "value": "4"
          }
        ]
      }
    }
  },
  {
    "name": "parses quoted scalar values",
    "query": "name=eq.\"Rio, RJ\"",
    "expected": {
      "where": {
        "kind": "comparison",
        "column": "name",
        "operator": "eq",
        "negated": false,
        "value": "Rio, RJ"
      }
    }
  },
  {
    "name": "pushes the columns and leaves ordering and pagination to PostgREST by default",
    "query": "id=gte.10&order=id.desc&limit=25&offset=5&select=id,name",
    "expected": {
      "where": {
        "kind": "comparison",
        "column": "id",
        "operator": "gte",
        "negated": false,
        "value": "10"
      },
      "columns": [
        "id",
        "name"
      ]
    }
  },
  {
    "name": "decodes URL values once",
    "query": "name=eq.Rio%20de%20Janeiro",
    "expected": {
      "where": {
        "kind": "comparison",
        "column": "name",
        "operator": "eq",
        "negated": false,
        "value": "Rio de Janeiro"
      }
    }
  },
  {
    "name": "keeps supported filters when independent filters are unsupported",
    "query": "id=eq.42&name=fts.search&select=id,name",
    "expected": {
      "where": {
        "kind": "comparison",
        "column": "id",
        "operator": "eq",
        "negated": false,
        "value": "42"
      }
    }
  },
  {
    "name": "omits a logical group with an unsupported child",
    "query": "id=eq.42&or=(name.eq.rio,description.fts.city)",
    "expected": {
      "where": {
        "kind": "comparison",
        "column": "id",
        "operator": "eq",
        "negated": false,
        "value": "42"
      }
    }
  },
  {
    "name": "omits a malformed equality",
    "query": "id=eq",
    "expected": null
  },
  {
    "name": "omits a malformed in list",
    "query": "id=in.(one,,two)",
    "expected": null
  },
  {
    "name": "omits a scalar in an in list",
    "query": "id=in.one",
    "expected": null
  },
  {
    "name": "omits a parenthesized scalar",
    "query": "id=eq.(one)",
    "expected": null
  },
  {
    "name": "omits every filter when a percent escape is not valid",
    "query": "id=eq.%ZZ",
    "expected": null
  },
  {
    "name": "omits a malformed logical group",
    "query": "and=id.eq.1",
    "expected": null
  },
  {
    "name": "omits an in list with a trailing comma",
    "query": "id=in.(1,2,)",
    "expected": null
  },
  {
    "name": "omits an empty in list",
    "query": "id=in.()",
    "expected": null
  },
  {
    "name": "omits an empty logical group",
    "query": "and=()",
    "expected": null
  },
  {
    "name": "omits a value with an unterminated quote",
    "query": "name=eq.\"abc",
    "expected": null
  },
  {
    "name": "omits an empty filter value",
    "query": "id=",
    "expected": null
  },
  {
    "name": "omits an empty logical group value",
    "query": "or=",
    "expected": null
  },
  {
    "name": "omits an uppercase operator",
