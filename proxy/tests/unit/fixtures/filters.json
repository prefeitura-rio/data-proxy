    "expected": {
      "where": {
        "kind": "comparison",
        "column": "id",
        "operator": "eq",
        "negated": false,
        "value": "1"
      }
    }
  },
  {
    "name": "pushes no columns when select has an alias",
    "query": "select=a:id",
    "expected": null
  },
  {
    "name": "pushes no columns when select has an embed",
    "query": "select=id,child(*)",
    "expected": null
  },
  {
    "name": "pushes no columns when select has an aggregate",
    "query": "select=count()",
    "expected": null
  },
  {
    "name": "pushes nothing when a filter is not supported",
    "query": "select=id&name=fts.x",
    "expected": null
  },
  {
    "name": "pushes nothing for a path in a filter key",
    "query": "select=id&a.b=eq.1",
    "expected": null
  },
  {
    "name": "pushes nothing for an unknown parameter",
    "query": "select=id&columns=id",
    "expected": null
  },
  {
    "name": "pushes nothing when select appears twice",
    "query": "select=id&select=name",
    "expected": null
  },
  {
    "name": "adds the order columns to the selected columns",
    "query": "select=id&order=name.desc",
    "expected": {
      "columns": [
        "id",
        "name"
      ]
    }
  },
  {
    "name": "pushes the limit with the order when the caller allows it",
    "query": "select=id&order=name.desc.nullslast&limit=10",
    "options": {
      "limit": true
    },
    "expected": {
      "columns": [
        "id",
        "name"
      ],
      "order": [
        {
          "column": "name",
          "descending": true,
          "nulls": "last"
        }
      ],
      "limit": 10
    }
  },
  {
    "name": "pushes an ascending order without nulls placement",
    "query": "order=id&limit=3",
    "options": {
      "limit": true
    },
    "expected": {
      "order": [
        {
          "column": "id",
          "descending": false
        }
      ],
      "limit": 3
    }
  },
  {
    "name": "pushes several order columns",
    "query": "order=id.asc,name.desc.nullsfirst&limit=3",
    "options": {
      "limit": true
    },
    "expected": {
      "order": [
        {
          "column": "id",
          "descending": false
        },
        {
          "column": "name",
          "descending": true,
          "nulls": "first"
        }
      ],
      "limit": 3
    }
  },
  {
    "name": "adds the offset to the limit",
    "query": "limit=10&offset=5",
    "options": {
      "limit": true
    },
    "expected": {
      "limit": 15
    }
  },
  {
    "name": "pushes the limit with a filter",
    "query": "id=eq.1&limit=2",
    "options": {
      "limit": true
    },
    "expected": {
      "where": {
        "kind": "comparison",
        "column": "id",
        "operator": "eq",
        "negated": false,
        "value": "1"
      },
      "limit": 2
    }
  },
  {
    "name": "pushes a limit of zero",
    "query": "limit=0",
    "options": {
      "limit": true
    },
    "expected": {
      "limit": 0
    }
  },
  {
    "name": "does not push the limit when the caller forbids it",
    "query": "limit=10",
    "expected": null
  },
  {
    "name": "pushes no limit when the offset is not a number",
    "query": "limit=10&offset=x",
    "options": {
      "limit": true
    },
    "expected": null
  },
  {
    "name": "pushes no limit when the limit is not a number",
    "query": "limit=ten",
    "options": {
      "limit": true
    },
    "expected": null
  },
  {
    "name": "pushes no limit when the limit is negative",
    "query": "limit=-1",
    "options": {
      "limit": true
    },
    "expected": null
  },
  {
    "name": "pushes no limit when the limit appears twice",
    "query": "limit=1&limit=2",
    "options": {
      "limit": true
    },
    "expected": null
  },
  {
    "name": "pushes no limit when the order has a path",
    "query": "order=a->b&limit=1",
    "options": {
      "limit": true
    },
    "expected": null
  },
  {
    "name": "pushes no limit when the order has an unknown modifier",
    "query": "order=id.up&limit=1",
    "options": {
      "limit": true
    },
    "expected": null
  },
  {
    "name": "pushes no limit when select has an aggregate",
    "query": "select=id.count()&limit=1",
    "options": {
      "limit": true
    },
    "expected": null
  },
  {
    "name": "pushes no limit when the limit has more than nine digits",
    "query": "limit=12345678901",
    "options": {
      "limit": true
    },
    "expected": null
  }
]
