  {
    "name": "omits a query that has no filter and selects every column",
    "query": "id=fts.x",
    "expected": null
  },
  {
    "name": "omits an empty query",
    "query": "",
    "expected": null
  },
  {
    "name": "omits a value with a doubled quote",
    "query": "name=eq.\"a\"\"b\"",
    "expected": null
  },
  {
