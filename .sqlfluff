[sqlfluff]
dialect = postgres
templater = jinja
max_line_length = 88
# LT02: Jinja block tags break the indentation check, 33 findings.
# RF04: the columns action, fields, name and owner are part of the deployed schema, 5 findings.
exclude_rules = LT02,RF04

[sqlfluff:templater:jinja]
apply_dbt_builtins = False
loader_search_path = sync/src/sync/templates,helm/files/templates

[sqlfluff:templater:jinja:context]
schema = pic
name = "'pic'"
table = people
view = people_bq
columns = id
object = people
function = people_bq_fn
partitioning = id
sort_columns = id
column = id
alterations = [{operation="add", column="active", type="BOOLEAN"}]
column_name = id
json_columns = id
method =
path = "'s3://bucket/partition.parquet'"
scratch_path = "'s3://bucket/scratch.parquet'"
temp = _batch
predicate = true

app_schema = data_proxy
dl_function = people_dl_fn
dl_view = ducklake_pic_people
bq_function = people_bq_fn
source_table = "'project.dataset.people'"
fallback = true
fallbacks = [{"name":"bigquery","function":"\"people_bq_fn\"","view":"source_pic_people"}]
has_rls = false
claim_setting = "'app.claim_sub'"
affected_partitions = "id >= 1"
rls_mappings = [{"column":"id_unit","unit_type":"unit"}]
old_table = people_old
next_table = people_next
duckdb_view = bq_fallback_pic_people
bq_table = "'project.dataset.people'"
catalog = "'ducklake:postgres:postgresql://user:password@localhost/ducklake'"
data_path = "'s3://bucket/ducklake/pic'"
encrypted = false
type = INTEGER
max_compacted_files = 10
rewrite_delete_threshold = 0.95
option = target_file_size
value = "'512MB'"
table_name = "'people'"
source_prefix =
source = "dl.people"
metadata_schema = pic
metadata = __ducklake_metadata_dl.pic
signer = "'console_signer'"
writer = "'ops'"
signer_role = "'console_signer'"
signer_password = "'secret'"
arguments = ()
lower = "'2024-01-01'"
upper = "'2024-02-01'"
s3_key_id = key
s3_secret_key = secret
s3_endpoint = endpoint
s3_use_ssl = false
duckdb_password = password
catalog_port = 5432
writer_role = ops
reader_role = duckdb
project = project
dataset = dataset
user_role = dp_user
anonymous_role = anon
serving_role = serving
scope = true
schemas = "ARRAY['pic']"
roles = ["anon", "dp_user", "dp_auth"]
parent_table = "'pic.people'"
interval = "'1 day'"
retention = "'30 days'"
log_retention_days = 90
window = "'30 days'"
clauses = "ALTER COLUMN payload SET DATA TYPE jsonb USING payload::jsonb"
load = "LOAD bigquery"
application_name = "'data-proxy-sync'"
live_executor_ids = "'[]'"
grace_seconds = 120
schema_argument = "'pic'"
schema_literal = "'pic'"
