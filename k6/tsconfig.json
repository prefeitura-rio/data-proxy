{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "bundler",
    "typeRoots": [
      "./types"
    ],
    "types": [
      "k6"
    ],
    "allowJs": true,
    "checkJs": true
  },
  "include": [
    "e2e.js",
    "load.js",
    "lib",
    "scenarios",
    "types"
  ]
}
